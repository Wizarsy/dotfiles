modules_wlan0="wpa_supplicant"

config_wlan0="192.168.0.203/24"

routes_wlan0="192.168.0.0/24 dev wlan0 table 101 scope link
default via 192.168.0.1 dev wlan0 table 101
default via 192.168.0.1 dev wlan0"

rules_wlan0="from 192.168.0.203 table 101 priority 101"

dns_domain_wlan0="lan"
dns_servers_wlan0="192.168.0.200 192.168.0.201"
